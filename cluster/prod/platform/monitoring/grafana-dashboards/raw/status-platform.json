{
  "id": null,
  "uid": "status-platform",
  "title": "Status Board - Platform",
  "tags": [
    "platform",
    "custom"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Ceph health",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "ceph_health_status",
          "legendFormat": null,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK"
                },
                "1": {
                  "text": "WARN"
                },
                "2": {
                  "text": "ERR"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "graphMode": "area",
        "colorMode": "background"
      }
    },
    {
      "id": 2,
      "type": "grafana-polystat-panel",
      "title": "OSD status",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "ceph_osd_up",
          "legendFormat": "{{ceph_daemon}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "autoSizeColumns": true,
        "layoutNumColumns": 8,
        "autoSizeRows": true,
        "layoutNumRows": 8,
        "layoutDisplayLimit": 100,
        "autoSizePolygons": true,
        "globalPolygonSize": "25",
        "globalPolygonBorderSize": 1,
        "globalTextFontFamily": "Roboto Mono",
        "globalAutoScaleFonts": true,
        "globalLabelFontSize": 12,
        "globalValueFontSize": 14,
        "globalCompositeValueFontSize": 14,
        "globalTextFontAutoColorEnabled": true,
        "globalTextFontColor": "#000000",
        "ellipseEnabled": false,
        "ellipseCharacters": 18,
        "sortByDirection": 1,
        "sortByField": "name",
        "globalTooltipsEnabled": true,
        "globalTooltipsFontFamily": "Roboto Mono",
        "globalTooltipsShowTimestampEnabled": false,
        "globalTooltipsShowValueEnabled": true,
        "globalShowTooltipColumnHeadersEnabled": true,
        "tooltipDisplayMode": "all",
        "tooltipDisplayTextTriggeredEmpty": "OK",
        "tooltipPrimarySortDirection": 1,
        "tooltipPrimarySortByField": "thresholdLevel",
        "tooltipSecondarySortDirection": 1,
        "tooltipSecondarySortByField": "value",
        "globalDisplayMode": "all",
        "globalDisplayTextTriggeredEmpty": "OK",
        "globalShowValueEnabled": false,
        "globalShowTimestampEnabled": false,
        "globalShowTimestampFormat": "YYYY-MM-DD HH:mm:ss",
        "globalShowTimestampFontSize": 12,
        "globalShowTimestampPosition": "below_value",
        "globalShowTimestampYOffset": 0,
        "globalShape": "hexagon_pointed_top",
        "globalGradientsEnabled": false,
        "globalFillColor": "transparent",
        "globalPolygonBorderColor": "transparent",
        "globalUnitFormat": "short",
        "globalOperator": "mean",
        "globalDecimals": 2,
        "globalThresholdsConfig": [
          {
            "value": 0,
            "state": 2,
            "color": "#f53636"
          },
          {
            "value": 1,
            "state": 0,
            "color": "green"
          }
        ],
        "globalClickthrough": "",
        "globalClickthroughSanitizedEnabled": true,
        "globalClickthroughNewTabEnabled": true,
        "globalClickthroughCustomTargetEnabled": false,
        "globalClickthroughCustomTarget": "",
        "globalRegexPattern": "",
        "overrideConfig": {
          "overrides": []
        },
        "compositeGlobalAliasingEnabled": false,
        "compositeConfig": {
          "composites": [],
          "enabled": true,
          "animationSpeed": "1500"
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "ArgoCD sync",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(argocd_app_info{sync_status!=\"Synced\"} or argocd_app_info{health_status!=\"Healthy\"})",
          "legendFormat": null,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "graphMode": "area",
        "colorMode": "background"
      }
    },
    {
