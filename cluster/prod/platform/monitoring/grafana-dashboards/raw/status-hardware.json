                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 10
                    },
                    {
                      "color": "red",
                      "value": 25
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Ready",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "node",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "includeByName": {
              "node": true,
              "Value #A": true,
              "Value #B": true,
              "os_image": true,
              "Value #D": true,
              "Value #E": true,
              "Value #F": true,
              "Value #G": true,
              "Value #H": true,
              "Value #I": true
            },
            "indexByName": {
              "node": 0,
              "Value #A": 1,
              "Value #B": 2,
              "os_image": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6,
              "Value #G": 7,
              "Value #H": 8,
              "Value #I": 9
            },
            "renameByName": {
              "node": "Node",
              "Value #A": "Ready",
              "Value #B": "Role",
              "os_image": "OS",
              "Value #D": "Taints",
              "Value #E": "Uptime",
              "Value #F": "Age",
              "Value #G": "CPU PSI",
              "Value #H": "RAM PSI",
              "Value #I": "Reboots (7d)"
            }
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "volkovlabs-echarts-panel",
      "title": "CPU \u2014 usage vs. request/limit (bullet)",
      "pluginVersion": "7.3.0",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (node) (rate(container_cpu_usage_seconds_total{container!=\"\",container!=\"POD\"}[5m]) * on(namespace,pod) group_left(node) topk by (namespace, pod) (1, kube_pod_info))",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "format": "table",
          "refId": "A"
        },
        {
          "expr": "sum by (node) (kube_node_status_allocatable{resource=\"cpu\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "format": "table",
          "refId": "B"
        },
        {
          "expr": "sum by (node) (kube_pod_container_resource_requests{resource=\"cpu\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "format": "table",
          "refId": "C"
        },
        {
          "expr": "sum by (node) (kube_pod_container_resource_limits{resource=\"cpu\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "format": "table",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "transformations": [],
      "options": {
        "renderer": "canvas",
        "map": "none",
        "editorMode": "code",
        "getOption": "\nconst frameMap = (refId) => {\n  const f = context.panel.data.series.find((s) => s.refId === refId);\n  if (!f) return {};\n  const nf = f.fields.find((fl) => fl.name === 'node');\n  const vf = f.fields.find((fl) => fl.name === 'Value #' + refId);\n  const m = {};\n  nf.values.forEach((n, i) => { m[n] = vf.values[i]; });\n  return m;\n};\nconst usageMap = frameMap('A'), capacityMap = frameMap('B'), requestMap = frameMap('C'), limitMap = frameMap('D');\nconst nodeSet = new Set([...Object.keys(usageMap), ...Object.keys(capacityMap), ...Object.keys(requestMap), ...Object.keys(limitMap)]);\nconst nodes = Array.from(nodeSet).sort();\nconst usage = nodes.map((n) => usageMap[n]);\nconst capacity = nodes.map((n) => capacityMap[n]);\nconst request = nodes.map((n) => requestMap[n]);\nconst limit = nodes.map((n) => limitMap[n]);\nconst fmt = (v) => (v == null ? '' : v.toFixed(2));\n\n// AXIS_MAX > 100 on purpose: clipping request to 100 hid overcommit - a\n// node at 104% of capacity requested looked identical to one exactly\n// at 100%. Axis extends to 150%, a solid reference line is drawn at\n// x=100, and a bar whose green segment crosses it visibly overshoots -\n// the distance past the line IS the overcommit, no separate flag\n// needed (explicitly requested: drop the warning icon/pin/text, the\n// line crossing is enough on its own).\n//\n// Two bands only - green (0->request) and red (request->end) - not\n// three. \"limit\" turned out to be a weak, inconsistent aggregate on\n// this cluster (most CPU limits are left unset entirely - a common,\n// deliberate k8s practice to avoid CPU-limit throttling - so the\n// summed \"limit\" number is usually just whatever handful of containers\n// happened to set one, not a real per-node ceiling). Still shown in\n// the tooltip as a plain fact, but no longer drawn as its own band or\n// tick - simpler, and matches what was actually being read off the\n// chart anyway.\nconst AXIS_MAX = 150;\nconst clip = (v) => Math.max(0, Math.min(AXIS_MAX, v));\nconst usagePct = usage.map((v,i) => capacity[i] ? clip(100*(v||0)/capacity[i]) : 0);\nconst reqPct = request.map((v,i) => capacity[i] ? clip(100*(v||0)/capacity[i]) : 0);\nconst bandLow = reqPct;\nconst bandHigh = reqPct.map((v) => AXIS_MAX - v);\n\nreturn {\n  animation: false, // otherwise every dashboard data refresh replays the draw-in animation on every element, including the reference line\n  grid: { left: 150, right: 70, top: 10, bottom: 30 },\n  xAxis: { type: 'value', min: 0, max: AXIS_MAX, axisLabel: { formatter: '{value}%' } },\n  yAxis: { type: 'category', inverse: true, data: nodes, axisLabel: { fontSize: 15 } },\n  tooltip: {\n    trigger: 'axis', axisPointer: { type: 'shadow' },\n    formatter: (params) => {\n      const i = params[0].dataIndex;\n      return nodes[i] + '<br/>Used: ' + fmt(usage[i]) + ' / ' + fmt(capacity[i]) + ' cores' +\n             '<br/>Request: ' + fmt(request[i]) + '  Limit: ' + fmt(limit[i]);\n    }\n  },\n  series: [\n    { name: 'under request', type: 'bar', stack: 'bands', barWidth: '55%', silent: true, z: 1,\n      itemStyle: { color: '#37872D' }, data: bandLow,\n      markLine: { silent: true, animation: false, symbol: 'none', label: { show: false },\n        lineStyle: { color: '#FFFFFF', width: 2, type: 'solid' }, data: [{ xAxis: 100 }] } },\n    { name: 'over request', type: 'bar', stack: 'bands', barWidth: '55%', silent: true, z: 1,\n      itemStyle: { color: '#C4162A' }, data: bandHigh },\n    { name: 'Usage', type: 'scatter', symbol: 'rect', symbolSize: [4, 24], z: 4,\n      itemStyle: { color: '#FFFFFF' },\n      label: { show: true, position: 'right', fontSize: 13, color: '#FFFFFF',\n        formatter: (p) => fmt(usage[p.dataIndex]) + ' / ' + fmt(capacity[p.dataIndex]) },\n      data: usagePct.map((v,i) => [v, i]) }\n  ]\n};\n",
        "editor": {
          "format": "auto"
        },
        "themeEditor": {
          "name": "default",
          "config": "{}"
        },
        "visualEditor": {
          "code": "",
          "dataset": [],
          "series": []
        },
        "baidu": {
          "key": "",
          "callback": "bmapReady"
        },
        "gaode": {
          "key": "",
          "plugin": "AMap.Scale,AMap.ToolBar"
        },
        "google": {
          "key": "",
          "callback": "gmapReady"
        }
      }
    },
    {
      "id": 9,
      "type": "volkovlabs-echarts-panel",
      "title": "RAM \u2014 usage vs. request/limit (bullet)",
      "pluginVersion": "7.3.0",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
