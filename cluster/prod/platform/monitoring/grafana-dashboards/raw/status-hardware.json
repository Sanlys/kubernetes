      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Ready",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "node",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "includeByName": {
              "node": true,
              "Value #A": true,
              "Value #B": true,
              "os_image": true,
              "Value #D": true,
              "Value #E": true,
              "Value #F": true,
              "Value #G": true,
              "Value #H": true,
              "Value #I": true,
              "Value #J": true,
              "Value #K": true,
              "Value #L": true,
              "Value #M": true,
              "Value #N": true,
              "Value #O": true,
              "Value #P": true,
              "Value #Q": true
            },
            "indexByName": {
              "node": 0,
              "Value #A": 1,
              "Value #B": 2,
              "os_image": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6,
              "Value #G": 7,
              "Value #H": 8,
              "Value #I": 9,
              "Value #J": 10,
              "Value #K": 11,
              "Value #L": 12,
              "Value #M": 13,
              "Value #N": 14,
              "Value #O": 15,
              "Value #P": 16,
              "Value #Q": 17
            },
            "renameByName": {
              "node": "Node",
              "Value #A": "Ready",
              "Value #B": "Role",
              "os_image": "OS",
              "Value #D": "Taints",
              "Value #E": "Uptime",
              "Value #F": "CPU",
              "Value #G": "CPU Used",
              "Value #H": "CPU Capacity",
              "Value #I": "CPU Req",
              "Value #J": "CPU Limit",
              "Value #K": "CPU PSI",
              "Value #L": "RAM",
              "Value #M": "RAM Used",
