        "editorMode": "code",
        "getOption": "\nconst col = (name) => {\n  for (const s of context.panel.data.series) {\n    const f = s.fields.find((f) => f.name === name);\n    if (f) return f.values;\n  }\n  return [];\n};\nconst nodes = col('node');\nconst usage = col('usage');\nconst capacity = col('capacity');\nconst request = col('request');\nconst limit = col('limit');\nconst fmt = (v) => {\n  if (v == null) return '';\n  const units = ['B','KiB','MiB','GiB','TiB'];\n  let i = 0; let x = v;\n  while (x >= 1024 && i < units.length - 1) { x /= 1024; i++; }\n  return x.toFixed(1) + ' ' + units[i];\n};\n\nconst usagePct = usage.map((v,i) => capacity[i] ? 100*v/capacity[i] : 0);\nconst reqPct = request.map((v,i) => capacity[i] ? 100*v/capacity[i] : 0);\nconst limPct = limit.map((v,i) => capacity[i] ? 100*v/capacity[i] : 0);\nconst bandLow = reqPct;\nconst bandMid = limPct.map((v,i) => Math.max(0, v - reqPct[i]));\nconst bandHigh = limPct.map((v,i) => Math.max(0, 100 - v));\n\nreturn {\n  grid: { left: 140, right: 70, top: 10, bottom: 30 },\n  xAxis: { type: 'value', min: 0, max: 100, axisLabel: { formatter: '{value}%' } },\n  yAxis: { type: 'category', inverse: true, data: nodes },\n  tooltip: {\n    trigger: 'axis', axisPointer: { type: 'shadow' },\n    formatter: (params) => {\n      const i = params[0].dataIndex;\n      return nodes[i] + '<br/>Used: ' + fmt(usage[i]) + ' / ' + fmt(capacity[i]) + '' +\n             '<br/>Request: ' + fmt(request[i]) + '  Limit: ' + fmt(limit[i]);\n    }\n  },\n  series: [\n    { name: 'under request', type: 'bar', stack: 'bands', barWidth: '55%', silent: true, z: 1,\n      itemStyle: { color: '#37872D' }, data: bandLow },\n    { name: 'over request', type: 'bar', stack: 'bands', barWidth: '55%', silent: true, z: 1,\n      itemStyle: { color: '#E0B400' }, data: bandMid },\n    { name: 'over limit', type: 'bar', stack: 'bands', barWidth: '55%', silent: true, z: 1,\n      itemStyle: { color: '#C4162A' }, data: bandHigh },\n    { name: 'Usage', type: 'bar', barWidth: '18%', barGap: '-100%', z: 3,\n      itemStyle: { color: '#1F2937' },\n      label: { show: true, position: 'right', formatter: (p) => fmt(usage[p.dataIndex]) + ' / ' + fmt(capacity[p.dataIndex]) },\n      data: usagePct },\n    { name: 'Request', type: 'scatter', symbol: 'rect', symbolSize: [3, 20], z: 4,\n      itemStyle: { color: '#000000' }, data: reqPct.map((v,i) => [v, i]) },\n    { name: 'Limit', type: 'scatter', symbol: 'rect', symbolSize: [3, 20], z: 4,\n      itemStyle: { color: '#8F3BF7' }, data: limPct.map((v,i) => [v, i]) }\n  ]\n};\n",
