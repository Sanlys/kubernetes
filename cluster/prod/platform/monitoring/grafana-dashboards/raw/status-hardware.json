{
  "id": null,
  "uid": "status-hardware",
  "title": "Status Board - Hardware",
  "tags": [
    "hardware",
    "custom"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Nodes Ready",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(kube_node_status_condition{condition=\"Ready\", status=\"true\"})",
          "legendFormat": null,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "graphMode": "area",
        "colorMode": "none"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cordoned / NotReady",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(kube_node_spec_unschedulable) or sum(kube_node_status_condition{condition=\"Ready\", status!=\"true\"})",
          "legendFormat": null,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "graphMode": "area",
        "colorMode": "background"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Hottest node (CPU)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "topk(1, 100 * sum by (node) (rate(container_cpu_usage_seconds_total{container!=\"\",container!=\"POD\"}[5m]) * on(namespace,pod) group_left(node) topk by (namespace, pod) (1, kube_pod_info)) / on(node) kube_node_status_allocatable{resource=\"cpu\"})",
          "legendFormat": "{{node}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "graphMode": "area",
        "colorMode": "none"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Nodes under DiskPressure",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(kube_node_status_condition{condition=\"DiskPressure\", status=\"true\"})",
          "legendFormat": null,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "graphMode": "area",
        "colorMode": "background"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Total CPU cores",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(kube_node_status_allocatable{resource=\"cpu\"})",
          "legendFormat": null,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "graphMode": "area",
        "colorMode": "none"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Total RAM",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(kube_node_status_allocatable{resource=\"memory\"})",
          "legendFormat": null,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "graphMode": "area",
        "colorMode": "none"
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Nodes",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "kube_node_status_condition{condition=\"Ready\", status=\"true\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "format": "table",
          "refId": "A"
        },
        {
          "expr": "(count by(node)(kube_node_spec_taint{key=\"node-role.kubernetes.io/control-plane\"})) or (sum by(node)(kube_node_info) * 0)",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "format": "table",
          "refId": "B"
        },
        {
          "expr": "kube_node_info",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "format": "table",
          "refId": "C"
        },
        {
          "expr": "(count by(node)(kube_node_spec_taint)) or (sum by(node)(kube_node_info) * 0)",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "format": "table",
          "refId": "D"
        },
        {
          "expr": "label_replace(time() - (node_boot_time_seconds * on(instance) group_left(nodename) node_uname_info), \"node\", \"$1\", \"nodename\", \"(.*)\")",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "format": "table",
          "refId": "E"
        },
        {
          "expr": "sum by (node) (rate(container_cpu_usage_seconds_total{container!=\"\",container!=\"POD\"}[5m]) * on(namespace,pod) group_left(node) topk by (namespace, pod) (1, kube_pod_info))",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "format": "table",
          "refId": "F"
        },
        {
          "expr": "sum by (node) (kube_node_status_allocatable{resource=\"cpu\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "format": "table",
          "refId": "G"
        },
        {
          "expr": "sum by (node) (kube_pod_container_resource_requests{resource=\"cpu\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "format": "table",
          "refId": "H"
        },
        {
          "expr": "sum by (node) (kube_pod_container_resource_limits{resource=\"cpu\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "format": "table",
          "refId": "I"
        },
        {
          "expr": "label_replace(100 * (rate(node_pressure_cpu_waiting_seconds_total[5m]) * on(instance) group_left(nodename) node_uname_info), \"node\", \"$1\", \"nodename\", \"(.*)\")",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "format": "table",
          "refId": "J"
        },
        {
          "expr": "sum by (node) (container_memory_working_set_bytes{container!=\"\",container!=\"POD\"} * on(namespace,pod) group_left(node) topk by (namespace, pod) (1, kube_pod_info))",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "format": "table",
          "refId": "K"
        },
        {
          "expr": "sum by (node) (kube_node_status_allocatable{resource=\"memory\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "format": "table",
          "refId": "L"
        },
        {
          "expr": "sum by (node) (kube_pod_container_resource_requests{resource=\"memory\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "format": "table",
          "refId": "M"
        },
        {
          "expr": "sum by (node) (kube_pod_container_resource_limits{resource=\"memory\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "format": "table",
          "refId": "N"
        },
        {
          "expr": "label_replace(100 * (rate(node_pressure_memory_waiting_seconds_total[5m]) * on(instance) group_left(nodename) node_uname_info), \"node\", \"$1\", \"nodename\", \"(.*)\")",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "format": "table",
          "refId": "O"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Ready"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "Ready",
                        "color": "green"
                      },
                      "0": {
                        "text": "Not Ready",
                        "color": "red"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Uptime"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Role"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "control-plane"
                      },
                      "0": {
                        "text": "worker"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU Used"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU Capacity"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU Req"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU Limit"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RAM Used"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RAM Capacity"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RAM Req"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RAM Limit"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU PSI"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 10
                    },
                    {
                      "color": "red",
                      "value": 25
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RAM PSI"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 10
                    },
                    {
                      "color": "red",
                      "value": 25
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Ready",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "node",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "includeByName": {
              "node": true,
              "Value #A": true,
              "Value #B": true,
              "os_image": true,
              "Value #D": true,
              "Value #E": true,
              "Value #F": true,
              "Value #G": true,
              "Value #H": true,
              "Value #I": true,
              "Value #J": true,
              "Value #K": true,
              "Value #L": true,
              "Value #M": true,
              "Value #N": true,
              "Value #O": true
            },
            "indexByName": {
              "node": 0,
              "Value #A": 1,
              "Value #B": 2,
              "os_image": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6,
              "Value #G": 7,
              "Value #H": 8,
              "Value #I": 9,
              "Value #J": 10,
              "Value #K": 11,
              "Value #L": 12,
              "Value #M": 13,
              "Value #N": 14,
              "Value #O": 15
            },
            "renameByName": {
              "node": "Node",
              "Value #A": "Ready",
              "Value #B": "Role",
              "os_image": "OS",
              "Value #D": "Taints",
              "Value #E": "Uptime",
              "Value #F": "CPU Used",
              "Value #G": "CPU Capacity",
              "Value #H": "CPU Req",
              "Value #I": "CPU Limit",
              "Value #J": "CPU PSI",
              "Value #K": "RAM Used",
              "Value #L": "RAM Capacity",
              "Value #M": "RAM Req",
              "Value #N": "RAM Limit",
              "Value #O": "RAM PSI"
            }
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "volkovlabs-echarts-panel",
      "title": "CPU \u2014 usage vs. request/limit (bullet)",
      "pluginVersion": "7.3.0",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (node) (rate(container_cpu_usage_seconds_total{container!=\"\",container!=\"POD\"}[5m]) * on(namespace,pod) group_left(node) topk by (namespace, pod) (1, kube_pod_info))",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "format": "table",
          "refId": "A"
        },
        {
          "expr": "sum by (node) (kube_node_status_allocatable{resource=\"cpu\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "format": "table",
          "refId": "B"
        },
        {
          "expr": "sum by (node) (kube_pod_container_resource_requests{resource=\"cpu\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "format": "table",
          "refId": "C"
        },
        {
          "expr": "sum by (node) (kube_pod_container_resource_limits{resource=\"cpu\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "format": "table",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "node",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "includeByName": {
              "node": true,
              "Value #A": true,
              "Value #B": true,
              "Value #C": true,
              "Value #D": true
            },
            "indexByName": {
              "node": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4
            },
            "renameByName": {
              "node": "node",
              "Value #A": "usage",
              "Value #B": "capacity",
              "Value #C": "request",
              "Value #D": "limit"
            }
          }
        }
      ],
      "options": {
        "renderer": "canvas",
        "map": "none",
        "editorMode": "code",
        "getOption": "\nconst col = (name) => {\n  for (const s of context.panel.data.series) {\n    const f = s.fields.find((f) => f.name === name);\n    if (f) return f.values;\n  }\n  return [];\n};\nconst nodes = col('node');\nconst usage = col('usage');\nconst capacity = col('capacity');\nconst request = col('request');\nconst limit = col('limit');\nconst fmt = (v) => (v == null ? '' : v.toFixed(2));\n\nconst usagePct = usage.map((v,i) => capacity[i] ? 100*v/capacity[i] : 0);\nconst reqPct = request.map((v,i) => capacity[i] ? 100*v/capacity[i] : 0);\nconst limPct = limit.map((v,i) => capacity[i] ? 100*v/capacity[i] : 0);\nconst bandLow = reqPct;\nconst bandMid = limPct.map((v,i) => Math.max(0, v - reqPct[i]));\nconst bandHigh = limPct.map((v,i) => Math.max(0, 100 - v));\n\nreturn {\n  grid: { left: 140, right: 70, top: 10, bottom: 30 },\n  xAxis: { type: 'value', min: 0, max: 100, axisLabel: { formatter: '{value}%' } },\n  yAxis: { type: 'category', inverse: true, data: nodes },\n  tooltip: {\n    trigger: 'axis', axisPointer: { type: 'shadow' },\n    formatter: (params) => {\n      const i = params[0].dataIndex;\n      return nodes[i] + '<br/>Used: ' + fmt(usage[i]) + ' / ' + fmt(capacity[i]) + ' cores' +\n             '<br/>Request: ' + fmt(request[i]) + '  Limit: ' + fmt(limit[i]);\n    }\n  },\n  series: [\n    { name: 'under request', type: 'bar', stack: 'bands', barWidth: '55%', silent: true, z: 1,\n      itemStyle: { color: '#37872D' }, data: bandLow },\n    { name: 'over request', type: 'bar', stack: 'bands', barWidth: '55%', silent: true, z: 1,\n      itemStyle: { color: '#E0B400' }, data: bandMid },\n    { name: 'over limit', type: 'bar', stack: 'bands', barWidth: '55%', silent: true, z: 1,\n      itemStyle: { color: '#C4162A' }, data: bandHigh },\n    { name: 'Usage', type: 'bar', barWidth: '18%', barGap: '-100%', z: 3,\n      itemStyle: { color: '#1F2937' },\n      label: { show: true, position: 'right', formatter: (p) => fmt(usage[p.dataIndex]) + ' / ' + fmt(capacity[p.dataIndex]) },\n      data: usagePct },\n    { name: 'Request', type: 'scatter', symbol: 'rect', symbolSize: [3, 20], z: 4,\n      itemStyle: { color: '#000000' }, data: reqPct.map((v,i) => [v, i]) },\n    { name: 'Limit', type: 'scatter', symbol: 'rect', symbolSize: [3, 20], z: 4,\n      itemStyle: { color: '#8F3BF7' }, data: limPct.map((v,i) => [v, i]) }\n  ]\n};\n",
        "editor": {
          "format": "auto"
        },
        "themeEditor": {
          "name": "default",
          "config": "{}"
        },
