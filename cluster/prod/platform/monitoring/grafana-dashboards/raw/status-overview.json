{
  "id": null,
  "uid": "status-overview",
  "title": "Status Board - Overview",
  "tags": [
    "overview",
    "custom"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Platform: Ceph health",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "ceph_health_status",
          "legendFormat": null,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK"
                },
                "1": {
                  "text": "WARN"
                },
                "2": {
                  "text": "ERR"
                }
              }
            }
          ],
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "graphMode": "area",
        "colorMode": "background"
      },
      "links": [
        {
          "title": "Open Platform board",
          "url": "/d/status-platform",
          "targetBlank": false
        }
      ],
      "description": "ceph_health_status: 0=OK, 1=WARN, 2=ERR. See the Platform board's Issues/PGs State panels for what's actually wrong."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Hardware: node problems",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(kube_node_status_condition{condition=~\"DiskPressure|MemoryPressure|PIDPressure\", status=\"true\"}) or sum(kube_node_spec_unschedulable) or vector(0)",
          "legendFormat": null,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "green"
                }
              }
            }
          ],
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "graphMode": "area",
        "colorMode": "background"
      },
      "links": [
        {
          "title": "Open Hardware board",
          "url": "/d/status-hardware",
          "targetBlank": false
        }
      ],
      "description": "Count of nodes under DiskPressure, MemoryPressure, PIDPressure, or cordoned. 0 is good; any other number is that many nodes with a real problem - see the Hardware board's Node status table."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Apps/Services: 5xx error rate",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "100 * sum(rate(traefik_service_requests_total{container=\"traefik-public\", code=~\"5..\"}[5m])) / sum(rate(traefik_service_requests_total{container=\"traefik-public\"}[5m]))",
          "legendFormat": null,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "graphMode": "area",
        "colorMode": "background"
      },
      "links": [
        {
          "title": "Open Apps/Services board",
          "url": "/d/status-apps",
          "targetBlank": false
        }
      ],
      "description": "% of all requests across every public app returning a 5xx in the last 5m. See the Apps/Services board for which app."
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Cluster CPU \u2014 used vs. allocatable",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{container!=\"\",container!=\"POD\"}[5m]))",
          "legendFormat": "used",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "A"
        },
        {
          "expr": "sum(kube_node_status_allocatable{resource=\"cpu\"})",
          "legendFormat": "allocatable",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cluster RAM \u2014 used vs. allocatable",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{container!=\"\",container!=\"POD\"})",
          "legendFormat": "used",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "A"
        },
        {
          "expr": "sum(kube_node_status_allocatable{resource=\"memory\"})",
          "legendFormat": "allocatable",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Ceph storage \u2014 used vs. total",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "ceph_cluster_total_used_bytes",
          "legendFormat": "used",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "A"
        },
        {
          "expr": "ceph_cluster_total_bytes",
          "legendFormat": "total",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Issues",
      "gridPos": {
        "h": 6,
        "w": 10,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "label_replace(label_replace(ceph_health_detail{name!~\"AUTH_INSECURE_CLIENT_KEY_TYPE|AUTH_INSECURE_KEYS_ALLOWED|AUTH_INSECURE_KEYS_CREATABLE\"} == 1, \"issue\", \"$1\", \"name\", \"(.*)\"), \"source\", \"Ceph\", \"\", \"\")",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "format": "table",
          "refId": "A"
        },
        {
          "expr": "label_replace(label_replace(ALERTS{alertstate=\"firing\", alertname!=\"Watchdog\"}, \"issue\", \"$1\", \"alertname\", \"(.*)\"), \"source\", \"K8s\", \"\", \"\")",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "format": "table",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Severity"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "HEALTH_WARN": {
                        "text": "Warning",
                        "color": "yellow"
                      },
                      "HEALTH_ERR": {
                        "text": "Critical",
                        "color": "red"
                      },
                      "warning": {
                        "text": "Warning",
                        "color": "yellow"
                      },
                      "critical": {
                        "text": "Critical",
                        "color": "red"
                      },
                      "none": {
                        "text": "",
                        "color": "text"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "applyToRow": true
                }
              },
              {
                "id": "custom.hideFrom.viz",
                "value": true
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "includeByName": {
              "source": true,
              "issue": true,
              "namespace": true,
              "severity": true
            },
            "indexByName": {
              "source": 0,
              "issue": 1,
              "namespace": 2,
              "severity": 3
            },
            "renameByName": {
              "source": "Source",
              "issue": "Issue",
              "namespace": "Namespace",
              "severity": "Severity"
            }
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Backup (restic)",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 20,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "time() - kube_cronjob_status_last_successful_time{namespace=\"syncthing\", cronjob=\"restic-backup\"}",
          "legendFormat": null,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 3600
              },
              {
                "color": "red",
                "value": 21600
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "graphMode": "area",
        "colorMode": "background"
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "ArgoCD apps not Synced/Healthy",
      "gridPos": {
        "h": 6,
        "w": 10,
        "x": 10,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "argocd_app_info{sync_status!=\"Synced\"} or argocd_app_info{health_status!=\"Healthy\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Sync"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Synced": {
                        "text": "Synced",
                        "color": "green"
                      },
                      "OutOfSync": {
                        "text": "OutOfSync",
                        "color": "yellow"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Health"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Healthy": {
                        "text": "Healthy",
                        "color": "green"
                      },
                      "Progressing": {
                        "text": "Progressing",
                        "color": "yellow"
                      },
                      "Degraded": {
                        "text": "Degraded",
                        "color": "red"
                      },
                      "Missing": {
                        "text": "Missing",
                        "color": "red"
                      },
                      "Suspended": {
                        "text": "Suspended",
                        "color": "yellow"
                      },
                      "Unknown": {
                        "text": "Unknown",
                        "color": "yellow"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "includeByName": {
              "name": true,
              "sync_status": true,
              "health_status": true
            },
            "indexByName": {
              "name": 0,
              "sync_status": 1,
              "health_status": 2
            },
            "renameByName": {
              "name": "App",
              "sync_status": "Sync",
              "health_status": "Health"
            }
          }
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "DS_LOKI",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {
          "text": "Loki",
          "value": "Loki"
        },
        "hide": 0,
        "refresh": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "url": "/d/status-overview",
      "icon": "external link"
    },
    {
      "title": "Platform",
      "type": "link",
      "url": "/d/status-platform",
      "icon": "external link"
    },
    {
      "title": "Hardware",
      "type": "link",
      "url": "/d/status-hardware",
      "icon": "external link"
    },
    {
      "title": "Apps/Services",
      "type": "link",
      "url": "/d/status-apps",
      "icon": "external link"
    }
  ],
  "__inputs": []
}