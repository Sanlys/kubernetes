    },
    {
      "type": "table",
      "title": "Top Countries by Bandwidth",
      "id": 34,
      "description": "Exact bytes straight from Loki (unwrap body_bytes_sent), not an extrapolated Prometheus increase().",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 44 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
