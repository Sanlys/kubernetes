{
  "uid": "mirror-analytics",
  "title": "Arch Mirror Analytics",
  "tags": ["mirror"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5m",
  "time": { "from": "now-30d", "to": "now" },
  "links": [],
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "prometheus" },
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "DS_LOKI",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": { "text": "Loki", "value": "Loki" },
        "hide": 0,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "id": 1,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Total Requests",
      "id": 2,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(loki_process_custom_mirror_requests_total[$__range]))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Total Bandwidth",
      "id": 3,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(loki_process_custom_mirror_bytes_total[$__range]))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Unique Visitors",
      "id": 4,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "count(count by (remote_addr) (count_over_time({namespace=\"mirror\", container=\"mirror\"} | json | __error__=\"\" [$__range])))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Time Since Last Sync",
      "id": 5,
      "description": "From the mirror's own lastsync file content, not just whether the CronJob ran - reflects actual data freshness.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "time() - loki_process_custom_mirror_lastsync_epoch_seconds",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 43200 },
              { "color": "red", "value": 86400 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Time Since Upstream Update",
      "id": 6,
      "description": "From upstream's own lastupdate file (rsync'd straight through - see mirror-script.yaml), not our own sync timestamp - reflects how stale upstream itself is, separate from how recently we last synced.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "time() - loki_process_custom_mirror_lastupdate_epoch_seconds",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 43200 },
              { "color": "red", "value": 86400 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "row",
      "title": "Traffic over time",
      "collapsed": false,
      "id": 10,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Requests",
      "id": 11,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(loki_process_custom_mirror_requests_total[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "requests/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Bandwidth",
      "id": 12,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(loki_process_custom_mirror_bytes_total[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "bytes/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] }
    },
    {
      "type": "row",
      "title": "Status codes & top content",
      "collapsed": false,
      "id": 20,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "panels": []
    },
    {
      "type": "piechart",
      "title": "Status Code Breakdown",
      "id": 21,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (status) (increase(loki_process_custom_mirror_requests_total{status!=\"\"}[$__range]))",
          "refId": "A",
          "instant": true,
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "type": "table",
      "title": "Top Requested Paths",
      "id": 22,
      "description": "A rising count on a package name you don't expect, or a flood of 404s on one path, can indicate stale package lists on clients or a broken sync.",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 19 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "topk(20, sum by (request_uri) (count_over_time({namespace=\"mirror\", container=\"mirror\"} | json | __error__=\"\" [$__range])))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "sortBy": [{ "displayName": "Value #A", "desc": true }] },
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true } } }
      ]
    },
    {
      "type": "row",
      "title": "Geography",
      "collapsed": false,
      "id": 30,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "panels": []
    },
    {
      "type": "geomap",
      "title": "Requests by Country",
      "description": "Country-level choropleth - no overlap ambiguity like the per-city heatmap had, every country is its own hoverable shape. Exact counts straight from Loki, not an extrapolated Prometheus increase() - at this granularity (a single country can mean one request in the whole window) extrapolation produced meaningless fractional noise.",
      "id": 31,
      "gridPos": { "h": 16, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum by (geoip_country_code) (count_over_time({namespace=\"mirror\", container=\"mirror\", geoip_country_code!=\"\"} | json | __error__=\"\" [$__range]))",
          "refId": "A",
          "queryType": "instant",
          "format": "table"
        }
      ],
      "options": {
        "basemap": { "type": "carto" },
        "layers": [
          {
            "type": "dynamic-geojson",
            "name": "Countries",
            "config": {
              "src": "public/maps/countries-alpha2.geojson",
              "idField": "geoip_country_code",
              "dataStyle": {
                "color": { "field": "Value #A" },
                "opacity": 0.8
              },
              "style": { "opacity": 0 },
              "rules": []
            }
          }
        ],
        "view": { "id": "zero", "lat": 0, "lon": 0, "zoom": 1 }
      },
      "fieldConfig": {
        "defaults": { "color": { "mode": "continuous-BlYlRd" } },
        "overrides": []
      }
    },
    {
      "type": "geomap",
      "title": "Bandwidth by Country",
      "description": "Country-level choropleth - no overlap ambiguity like the per-city heatmap had, every country is its own hoverable shape. Exact bytes straight from Loki (unwrap body_bytes_sent), not an extrapolated Prometheus increase() - at this granularity extrapolation produced meaningless noise.",
      "id": 32,
      "gridPos": { "h": 16, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum by (geoip_country_code) (sum_over_time({namespace=\"mirror\", container=\"mirror\", geoip_country_code!=\"\"} | json | unwrap body_bytes_sent | __error__=\"\" [$__range]))",
          "refId": "A",
          "queryType": "instant",
          "format": "table"
        }
      ],
      "options": {
        "basemap": { "type": "carto" },
        "layers": [
          {
            "type": "dynamic-geojson",
            "name": "Countries",
            "config": {
              "src": "public/maps/countries-alpha2.geojson",
              "idField": "geoip_country_code",
              "dataStyle": {
                "color": { "field": "Value #A" },
                "opacity": 0.8
              },
              "style": { "opacity": 0 },
              "rules": []
            }
          }
        ],
        "view": { "id": "zero", "lat": 0, "lon": 0, "zoom": 1 }
      },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "color": { "mode": "continuous-BlYlRd" } },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Top Countries by Requests",
      "id": 33,
      "description": "Exact counts straight from Loki, not an extrapolated Prometheus increase() - a country with just a handful of requests in the window would otherwise show a meaningless extrapolated fraction.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 44 },
