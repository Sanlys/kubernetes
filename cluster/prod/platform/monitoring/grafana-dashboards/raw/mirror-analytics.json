          "expr": "topk(20, sum by (geoip_country_code) (sum_over_time({namespace=\"mirror\", container=\"mirror\", geoip_country_code!=\"\"} | json | unwrap body_bytes_sent | __error__=\"\" [$__range])))",
          "refId": "A",
          "queryType": "instant",
