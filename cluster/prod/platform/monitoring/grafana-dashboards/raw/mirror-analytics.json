{
  "uid": "mirror-analytics",
  "title": "Arch Mirror Analytics",
  "tags": ["mirror"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5m",
  "time": { "from": "now-30d", "to": "now" },
  "links": [],
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "prometheus" },
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "DS_LOKI",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": { "text": "Loki", "value": "Loki" },
        "hide": 0,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "id": 1,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "type": "text",
      "title": "",
      "id": 100,
      "gridPos": { "h": 2, "w": 24, "x": 0, "y": 1 },
      "options": {
        "mode": "markdown",
        "content": "Requests/bandwidth come from Alloy-derived Prometheus counters (31d retention). Unique visitors and top paths query raw logs in Loki directly (40d retention) - both are bounded by the dashboard time range above. \"Unique visitors\" = distinct source IPs, the standard proxy for this kind of analytics; it under/overcounts somewhat with NAT and dynamic IPs."
      },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Total Requests",
      "id": 2,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 3 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(mirror_requests_total[$__range]))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Total Bandwidth",
      "id": 3,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 3 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(mirror_bytes_total[$__range]))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "decimals": 1 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Unique Visitors",
      "id": 4,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 3 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "count(count by (remote_addr) (count_over_time({namespace=\"mirror\", container=\"mirror\"} | json [$__range])))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Time Since Last Sync",
      "id": 5,
      "description": "From the mirror's own lastsync file content, not just whether the CronJob ran - reflects actual data freshness.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 3 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "time() - mirror_lastsync_epoch_seconds",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 43200 },
              { "color": "red", "value": 86400 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "row",
      "title": "Traffic over time",
      "collapsed": false,
      "id": 10,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Requests",
      "id": 11,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(mirror_requests_total[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "requests/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Bandwidth",
      "id": 12,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(mirror_bytes_total[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "bytes/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] }
    },
    {
      "type": "row",
      "title": "Status codes & top content",
      "collapsed": false,
      "id": 20,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "panels": []
    },
    {
      "type": "piechart",
      "title": "Status Code Breakdown",
      "id": 21,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (status) (increase(mirror_requests_total[$__range]))",
          "refId": "A",
          "instant": true,
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "type": "table",
      "title": "Top Requested Paths",
      "id": 22,
      "description": "A rising count on a package name you don't expect, or a flood of 404s on one path, can indicate stale package lists on clients or a broken sync.",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 17 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "topk(20, sum by (request_uri) (count_over_time({namespace=\"mirror\", container=\"mirror\"} | json [$__range])))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true } } }
      ]
    },
    {
      "type": "row",
      "title": "Geography",
      "collapsed": false,
      "id": 30,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "panels": []
    },
    {
      "type": "geomap",
      "title": "Requests by Country",
      "id": 31,
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (geoip_country_code) (increase(mirror_requests_total[$__range]))",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "basemap": { "type": "carto" },
        "layers": [
          {
            "type": "markers",
            "config": {
              "data": { "value": "Value" },
              "location": {
                "mode": "lookup",
                "lookup": "geoip_country_code",
                "gazetteer": "countries"
              },
              "size": { "fixed": 5, "min": 2, "max": 30 },
              "color": { "mode": "value" }
            }
          }
        ]
      },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "type": "geomap",
      "title": "Bandwidth by Country",
      "id": 32,
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (geoip_country_code) (increase(mirror_bytes_total[$__range]))",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "basemap": { "type": "carto" },
        "layers": [
          {
            "type": "markers",
            "config": {
              "data": { "value": "Value" },
              "location": {
                "mode": "lookup",
                "lookup": "geoip_country_code",
                "gazetteer": "countries"
              },
              "size": { "fixed": 5, "min": 2, "max": 30 },
              "color": { "mode": "value" }
            }
          }
        ]
      },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "type": "table",
      "title": "Top Countries by Requests",
      "id": 33,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "topk(20, sum by (geoip_country_code) (increase(mirror_requests_total[$__range])))",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true } } }
      ]
    },
    {
      "type": "table",
      "title": "Top Countries by Bandwidth",
      "id": 34,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "topk(20, sum by (geoip_country_code) (increase(mirror_bytes_total[$__range])))",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true } } }
      ]
    },
    {
      "type": "table",
      "title": "Unique Visitors by Country",
      "id": 35,
      "description": "Bounded by Loki's 40d retention, same as the Unique Visitors stat above.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 44 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "topk(20, count by (geoip_country_code) (count by (geoip_country_code, remote_addr) (count_over_time({namespace=\"mirror\", container=\"mirror\"} | json [$__range]))))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true } } }
      ]
    }
  ]
}
